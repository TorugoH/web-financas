+    public RendaResponse atualizarTaxaInvestimento(Long idLancamento, BigDecimal taxaAnual, String emailUsuario) {
+        validarTaxaAnual(taxaAnual);
+        RendaLancamento lancamento = lancamentoRepository.findById(idLancamento)
+                .orElseThrow(() -> new IllegalArgumentException("Investimento nao encontrado"));
+        Renda renda = lancamento.getRenda();
+        if (!renda.getUsuario().getEmail().equals(emailUsuario)) {
+            throw new IllegalArgumentException("Voce nao tem permissao para editar esse investimento");
+        }
+        if (renda.getTipo() != TipoRendaEnum.INVESTIMENTO) {
+            throw new IllegalArgumentException("Lancamento nao e um investimento");
+        }
+        renda.setTaxaAnual(taxaAnual);
+        return rendaMapper.toResponse(rendaRepository.save(renda));
+    }
+
+    private void validarTaxaAnual(BigDecimal taxa) {
+        if (taxa == null || taxa.signum() < 0 || taxa.compareTo(new BigDecimal("1000")) > 0
+                || taxa.stripTrailingZeros().scale() > 6) {
+            throw new IllegalArgumentException("Informe uma taxa anual de 0 a 1000, com ate 6 casas decimais");
+        }
